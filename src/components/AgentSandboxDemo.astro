---
---
<div class="relative w-full rounded-2xl bg-[var(--bg-card)] border border-[var(--border-subtle)] p-6 md:p-8 overflow-hidden font-mono text-sm shadow-2xl select-none backdrop-blur-2xl">
  <!-- Subtle grid mesh background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--accent-soft)_0%,transparent_60%)] pointer-events-none"></div>

  <!-- Header with Live Badge and Trigger Actions -->
  <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-6 mb-6">
    <div>
      <span class="text-xs text-[var(--accent)] tracking-wider uppercase font-bold flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent)]"></span>
        </span>
        Interactive Live Architecture Sandbox
      </span>
      <h3 class="text-lg font-bold text-[var(--text-primary)] font-heading mt-1">Autonomous Agent Sandbox Execution Flow</h3>
    </div>

    <!-- Simulation Trigger Buttons -->
    <div class="flex items-center gap-2">
      <button
        id="sim-trigger-btn"
        type="button"
        class="btn-primary text-xs py-2 px-3.5"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
        </svg>
        <span id="sim-btn-text">Run Valid Flow</span>
      </button>

      <button
        id="sim-attack-btn"
        type="button"
        class="border border-red-500/40 rounded-full px-3 py-1.5 text-xs font-semibold text-red-400 bg-red-500/10 hover:bg-red-500/20 active:scale-95 transition-all cursor-pointer flex items-center gap-1.5 font-mono"
        title="Simulate prompt injection and unauthorized scope elevation"
      >
        <span>⚠️ Simulate Attack</span>
      </button>
    </div>
  </div>

  <!-- Interactive Diagram Nodes -->
  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6 md:gap-3 max-w-4xl mx-auto py-4">
    
    <!-- Node 1: AI Agent -->
    <div id="agent-node" class="flex flex-col items-center group cursor-pointer z-10 transition-all duration-300 rounded-xl p-2 hover:scale-105" title="Click to inspect Agent node">
      <div class="w-14 h-14 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex items-center justify-center relative shadow-lg group-hover:border-[var(--accent)] transition-colors">
        <svg class="w-7 h-7 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <div id="agent-status-light" class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-emerald-400 border-2 border-[var(--bg-canvas)]"></div>
      </div>
      <span class="text-xs font-bold text-[var(--text-primary)] mt-2">AI Agent</span>
      <span class="text-[10px] text-[var(--text-muted)]">Autonomous Worker</span>
    </div>

    <!-- Arrow 1 -->
    <div class="flex items-center text-[var(--text-muted)] opacity-60">
      <svg class="w-5 h-5 hidden md:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      <svg class="w-5 h-5 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 17l-4 4m0 0l-4-4m4 4V3" /></svg>
    </div>

    <!-- Node 2: Identity Boundary (OAuth2) -->
    <div id="iam-node" class="flex flex-col items-center group cursor-pointer z-10 transition-all duration-300 rounded-xl p-2 hover:scale-105" title="Click to inspect IAM Gateway">
      <div class="w-14 h-14 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex items-center justify-center relative shadow-lg group-hover:border-[var(--accent)] transition-colors">
        <svg class="w-7 h-7 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <div id="iam-status-light" class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-[var(--text-muted)] border-2 border-[var(--bg-canvas)]"></div>
      </div>
      <span class="text-xs font-bold text-[var(--text-primary)] mt-2">IAM Gateway</span>
      <span class="text-[10px] text-[var(--text-muted)]">OAuth2 M2M Token</span>
    </div>

    <!-- Arrow 2 -->
    <div class="flex items-center text-[var(--text-muted)] opacity-60">
      <svg class="w-5 h-5 hidden md:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      <svg class="w-5 h-5 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 17l-4 4m0 0l-4-4m4 4V3" /></svg>
    </div>

    <!-- Node 3: Zanzibar ReBAC -->
    <div id="zanzibar-node" class="flex flex-col items-center group cursor-pointer z-10 transition-all duration-300 rounded-xl p-2 hover:scale-105" title="Click to inspect Zanzibar Policy">
      <div class="w-14 h-14 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex items-center justify-center relative shadow-lg group-hover:border-[var(--accent)] transition-colors">
        <svg class="w-7 h-7 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <div id="zanzibar-status-light" class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-[var(--text-muted)] border-2 border-[var(--bg-canvas)]"></div>
      </div>
      <span class="text-xs font-bold text-[var(--text-primary)] mt-2">Zanzibar ReBAC</span>
      <span class="text-[10px] text-[var(--text-muted)]">Relationship Check</span>
    </div>

    <!-- Arrow 3 -->
    <div class="flex items-center text-[var(--text-muted)] opacity-60">
      <svg class="w-5 h-5 hidden md:block" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      <svg class="w-5 h-5 md:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 17l-4 4m0 0l-4-4m4 4V3" /></svg>
    </div>

    <!-- Node 4: Isolated MicroVM / K8s Sandbox -->
    <div id="sandbox-node" class="flex flex-col items-center group cursor-pointer z-10 transition-all duration-300 rounded-xl p-2 hover:scale-105" title="Click to inspect Sandbox workload">
      <div class="w-14 h-14 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] flex items-center justify-center relative shadow-lg group-hover:border-[var(--accent)] transition-colors">
        <svg class="w-7 h-7 text-[var(--text-secondary)] group-hover:text-[var(--accent)] transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <div id="sandbox-status-light" class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-[var(--text-muted)] border-2 border-[var(--bg-canvas)]"></div>
      </div>
      <span class="text-xs font-bold text-[var(--text-primary)] mt-2">Zero-Trust Sandbox</span>
      <span class="text-[10px] text-[var(--text-muted)]">Ephemeral Execution</span>
    </div>

  </div>

  <!-- Live Terminal Log Window -->
  <div class="mt-6 border border-[var(--border-subtle)] rounded-xl bg-black/80 p-4 font-mono text-xs overflow-hidden">
    <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/10 text-[var(--text-muted)] text-[11px]">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
        <span class="ml-2 text-white/70">audit.log &mdash; real-time policy trace</span>
      </div>
      <span id="sim-status-badge" class="text-emerald-400 font-bold">READY</span>
    </div>
    <div id="terminal-output" class="space-y-1 text-gray-300 max-h-24 overflow-y-auto leading-relaxed">
      <div class="text-gray-500">[SYSTEM] Identity platform ready. Click 'Run Valid Flow' or 'Simulate Attack' above to test.</div>
    </div>
  </div>
</div>

<script>
  function setupSandboxSimulation() {
    const triggerBtn = document.getElementById('sim-trigger-btn');
    const attackBtn = document.getElementById('sim-attack-btn');
    const terminal = document.getElementById('terminal-output');
    const badge = document.getElementById('sim-status-badge');
    const iamLight = document.getElementById('iam-status-light');
    const zanzibarLight = document.getElementById('zanzibar-status-light');
    const sandboxLight = document.getElementById('sandbox-status-light');

    function log(msg: string, color = 'text-gray-300') {
      if (!terminal) return;
      const el = document.createElement('div');
      el.className = color;
      el.textContent = `[${new Date().toISOString().substring(11, 19)}] ${msg}`;
      terminal.appendChild(el);
      terminal.scrollTop = terminal.scrollHeight;
    }

    function resetLights() {
      [iamLight, zanzibarLight, sandboxLight].forEach(l => {
        if (l) l.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-gray-500 border-2 border-[var(--bg-canvas)]';
      });
    }

    triggerBtn?.addEventListener('click', () => {
      resetLights();
      if (terminal) terminal.innerHTML = '';
      if (badge) { badge.textContent = 'RUNNING'; badge.className = 'text-cyan-400 font-bold'; }
      log('Autonomous agent requests execution with scope: "k8s:cluster:read"', 'text-cyan-400');

      setTimeout(() => {
        if (iamLight) iamLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-cyan-400 border-2 border-[var(--bg-canvas)] animate-pulse';
        log('IAM Gateway: Issued short-lived M2M token (TTL=15m, subject="agent-worker-1")', 'text-gray-300');
      }, 700);

      setTimeout(() => {
        if (zanzibarLight) zanzibarLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-emerald-400 border-2 border-[var(--bg-canvas)]';
        log('Zanzibar: Relationship verified (owner="platform-team", resource="tenant-prod")', 'text-emerald-400');
      }, 1400);

      setTimeout(() => {
        if (sandboxLight) sandboxLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-emerald-400 border-2 border-[var(--bg-canvas)]';
        log('Sandbox: Workload started in isolated microVM. Network policies enforced.', 'text-emerald-300');
        if (badge) { badge.textContent = 'SUCCESS'; badge.className = 'text-emerald-400 font-bold'; }
      }, 2100);
    });

    attackBtn?.addEventListener('click', () => {
      resetLights();
      if (terminal) terminal.innerHTML = '';
      if (badge) { badge.textContent = 'ATTACK BLOCKED'; badge.className = 'text-red-400 font-bold'; }
      log('Simulating prompt injection: Agent attempts unauthorized privilege escalation', 'text-yellow-400');

      setTimeout(() => {
        if (iamLight) iamLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-yellow-400 border-2 border-[var(--bg-canvas)]';
        log('IAM Gateway: Scope elevation requested (attempted "cluster-admin")', 'text-yellow-300');
      }, 700);

      setTimeout(() => {
        if (zanzibarLight) zanzibarLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-red-500 border-2 border-[var(--bg-canvas)] animate-ping';
        log('Zanzibar 403 FORBIDDEN: Denied unauthorized relation. Execution halted.', 'text-red-400 font-bold');
        if (sandboxLight) sandboxLight.className = 'absolute -top-1 -right-1 w-3 h-3 rounded-full bg-red-500 border-2 border-[var(--bg-canvas)]';
        log('Sandbox: Zero-trust boundary contained blast radius. Pod creation blocked.', 'text-red-300');
      }, 1400);
    });
  }

  setupSandboxSimulation();
  document.addEventListener('astro:page-load', setupSandboxSimulation);
</script>
