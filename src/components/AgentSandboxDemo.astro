<section class="sandbox" aria-labelledby="sandbox-title">
<div class="sandbox-head"><div><p class="eyebrow blue">An illustrated sequence / Simulation</p><h3 id="sandbox-title">From request to execution.</h3></div><button type="button" class="button" id="sim-trigger-btn">Run walkthrough <span aria-hidden="true"> →</span></button></div>
<ol class="sandbox-steps"><li data-step="0"><span>01</span><strong>Request</strong><small>Agent asks to act</small></li><li data-step="1"><span>02</span><strong>Authorize</strong><small>Check the relationship</small></li><li data-step="2"><span>03</span><strong>Execute</strong><small>Isolate the workload</small></li><li data-step="3"><span>04</span><strong>Clean up</strong><small>End the execution</small></li></ol>
<p class="sandbox-status" id="sim-status" role="status" aria-live="polite" aria-atomic="true">Ready. Follow a scoped request through the boundary.</p>
<p class="sandbox-caption">Illustrative only. No real tokens, infrastructure, or workloads are created.</p>
</section>
<style>
.sandbox{margin-top:28px;border:1px solid #cbd3ee;background:#eef1fb;padding:26px}.sandbox-head{display:flex;align-items:center;justify-content:space-between;gap:18px}.sandbox-head h3{font-family:var(--serif);font-size:27px;margin-top:7px}.sandbox-head button{flex-shrink:0}.sandbox-steps{list-style:none;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:30px 0}.sandbox-steps li{padding:13px 10px;border-top:2px solid #cbd3ee}.sandbox-steps span{display:block;font-family:var(--mono);color:#626c87;font-size:12px}.sandbox-steps strong{display:block;font-weight:500;font-size:15px;margin:6px 0}.sandbox-steps small{font-size:12px;color:#596378;display:block}.sandbox-steps li.active{border-color:var(--blue);background:#e0e6fa}.sandbox-status{font-size:15px;min-height:52px;color:#234bda}.sandbox-caption{font-size:12px;color:#596378;margin-top:10px}.sandbox button:disabled{opacity:.6;cursor:wait}@media(max-width:760px){.sandbox{padding:20px}.sandbox-head{align-items:flex-start;flex-direction:column}.sandbox-steps{grid-template-columns:repeat(2,1fr)}}
</style>
<script>
const button=document.querySelector<HTMLButtonElement>('#sim-trigger-btn');
const status=document.querySelector<HTMLElement>('#sim-status');
const steps=document.querySelectorAll<HTMLElement>('.sandbox-steps li');
const messages=['The agent requests an action with an explicit scope and resource.','The policy layer checks whether this agent can act on this resource.','An authorized request runs inside an isolated execution environment.','Execution ends. Temporary access and the isolated workload are cleaned up.'];
let timer:ReturnType<typeof setTimeout>|undefined;
button?.addEventListener('click',()=>{
 if(!button||!status)return;
 button.disabled=true;button.textContent='Walking through…';
 steps.forEach(step=>step.classList.remove('active'));
 let index=0;
 const advance=()=>{steps.forEach((step,i)=>step.classList.toggle('active',i===index));status.textContent=messages[index];index++;
 if(index<messages.length)timer=setTimeout(advance,1500);
 else timer=setTimeout(()=>{status.textContent='Walkthrough complete. Permission is checked before execution, and access is bounded by the task.';button.disabled=false;button.textContent='Run again →';},1500);};
 advance();
});
window.addEventListener('pagehide',()=>{if(timer)clearTimeout(timer)});
</script>
