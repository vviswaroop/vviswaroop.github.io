---
---
<div class="relative w-full rounded-2xl bg-surface border border-white/5 p-6 md:p-8 overflow-hidden font-mono text-sm shadow-2xl relative select-none">
  <!-- Grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px] pointer-events-none"></div>
  
  <!-- Title & Action Header -->
  <div class="relative z-10 flex flex-col sm:flex-row items-center justify-between gap-4 border-b border-white/5 pb-6 mb-6">
    <div>
      <span class="text-xs text-accent tracking-wider uppercase font-bold">Interactive Architecture</span>
      <h3 class="text-lg font-bold text-white font-heading mt-1">Autonomous Agent Sandbox Execution Flow</h3>
    </div>
    <button 
      id="sim-trigger-btn" 
      class="border border-accent/30 rounded px-4 py-2 text-xs font-semibold text-accent bg-accent/5 hover:bg-accent/15 active:bg-accent/25 transition-all cursor-pointer shadow-lg shadow-accent/5 flex items-center gap-2 font-mono"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5" id="play-icon">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347a1.125 1.125 0 0 1-1.667-.986V5.653Z" />
      </svg>
      <span id="sim-btn-text">Run Pipeline Simulation</span>
    </button>
  </div>

  <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-4 max-w-4xl mx-auto py-4">
    
    <!-- AI Agent -->
    <div id="agent-node" class="flex flex-col items-center group cursor-default z-10 transition-all duration-500 rounded-xl p-2 border border-transparent">
      <div class="w-16 h-16 rounded-xl bg-background border border-white/10 flex items-center justify-center relative shadow-lg group-hover:border-accent/40 transition-colors duration-300">
        <svg class="w-8 h-8 text-white/80 group-hover:text-accent transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <div class="absolute inset-0 rounded-xl border border-accent/0 group-hover:animate-ping group-hover:border-accent/40"></div>
      </div>
      <div class="mt-3 text-center">
        <span class="block text-white font-semibold">Autonomous Agent</span>
        <span class="block text-xs text-gray-500 mt-1">n8n / LangChain</span>
      </div>
    </div>

    <!-- Arrow 1 (Request) -->
    <div id="arrow-request" class="flex-1 min-w-[60px] max-w-[120px] flex items-center justify-center relative h-8 hidden md:flex opacity-30 transition-all duration-500">
      <div class="w-full h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent absolute"></div>
      <div class="w-2 h-2 rounded-full bg-accent absolute flow-bullet"></div>
    </div>

    <!-- Arrow 1 Mobile -->
    <div id="arrow-request-mobile" class="w-px h-12 bg-gradient-to-b from-transparent via-accent/50 to-transparent relative md:hidden opacity-30 transition-all duration-500">
      <div class="w-2 h-2 rounded-full bg-accent absolute -left-[3.5px] flow-bullet-vertical"></div>
    </div>

    <!-- Auth Boundary (Zanzibar) -->
    <div id="auth-node" class="flex flex-col items-center group z-10 transition-all duration-500 rounded-xl p-2 border border-transparent">
      <div class="px-6 py-4 rounded-xl bg-background border border-white/10 flex flex-col items-center relative shadow-lg group-hover:border-accent/30 transition-all duration-300">
        <div class="absolute -top-3 bg-surface px-2 text-[10px] text-accent tracking-widest uppercase font-semibold border border-white/5 rounded-full px-2 py-0.5">Boundary</div>
        <svg class="w-6 h-6 text-gray-400 mb-2 group-hover:text-white transition-colors duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
        <span class="text-white font-semibold text-sm">Policy Check</span>
      </div>
      <div class="mt-3 text-center">
        <span class="block text-xs text-gray-500 mt-1">Zanzibar / OpenFGA</span>
      </div>
    </div>

    <!-- Arrow 2 (Approved Execution) -->
    <div id="arrow-execution" class="flex-1 min-w-[60px] max-w-[120px] flex items-center justify-center relative h-8 hidden md:flex opacity-30 transition-all duration-500">
      <div class="w-full h-px bg-gradient-to-r from-transparent via-green-500/50 to-transparent absolute"></div>
      <div class="w-2 h-2 rounded-full bg-green-400 absolute flow-bullet"></div>
    </div>

    <!-- Arrow 2 Mobile -->
    <div id="arrow-execution-mobile" class="w-px h-12 bg-gradient-to-b from-transparent via-green-500/50 to-transparent relative md:hidden opacity-30 transition-all duration-500">
      <div class="w-2 h-2 rounded-full bg-green-400 absolute -left-[3.5px] flow-bullet-vertical"></div>
    </div>

    <!-- Secure Sandbox -->
    <div id="sandbox-node" class="flex flex-col items-center group z-10 transition-all duration-500 rounded-xl p-2 border border-transparent">
      <div class="w-24 h-24 rounded-2xl bg-background border border-white/10 flex flex-col items-center justify-center relative shadow-lg overflow-hidden group-hover:border-green-500/30 transition-all duration-300">
        <div class="absolute inset-0 bg-green-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
        <svg class="w-8 h-8 text-white/80 group-hover:text-green-400 transition-colors duration-300 mb-2 relative z-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
        </svg>
        <span class="text-xs font-semibold text-white relative z-10">K8s Pod</span>
      </div>
      <div class="mt-3 text-center">
        <span class="block text-white font-semibold">Execution Sandbox</span>
        <span class="block text-xs text-gray-500 mt-1">EKS / Firecracker</span>
      </div>
    </div>

  </div>

  <!-- Simulation Logs Panel -->
  <div id="sim-log-panel" class="mt-6 border border-white/5 rounded-xl bg-black/60 p-4 max-w-4xl mx-auto opacity-0 h-0 overflow-hidden transition-all duration-500">
    <div class="flex items-center justify-between border-b border-white/5 pb-2 mb-3">
      <span class="text-[10px] text-gray-500 font-bold uppercase tracking-widest font-sans flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
        Sandbox Logs
      </span>
      <span id="sim-log-status" class="text-[10px] text-accent/80 font-bold">READY</span>
    </div>
    <div id="sim-log-stream" class="flex flex-col gap-1 text-[11px] text-gray-400 font-mono min-h-[100px] max-h-[150px] overflow-y-auto">
      <!-- Live logs injected here -->
    </div>
  </div>
</div>

<style>
  /* Base custom states */
  .node-active {
    border-color: rgba(0, 194, 255, 0.2) !important;
    background-color: rgba(0, 194, 255, 0.02) !important;
    box-shadow: 0 0 25px rgba(0, 194, 255, 0.05);
  }
  
  .node-active-green {
    border-color: rgba(34, 197, 94, 0.2) !important;
    background-color: rgba(34, 197, 94, 0.02) !important;
    box-shadow: 0 0 25px rgba(34, 197, 94, 0.05);
  }

  .arrow-active {
    opacity: 1 !important;
  }

  .flow-bullet-active {
    animation: flow 1.5s infinite linear;
  }

  .flow-bullet-vertical-active {
    animation: flow-vertical 1.5s infinite linear;
  }

  @keyframes flow {
    0% { left: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  
  @keyframes flow-vertical {
    0% { top: 0%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 100%; opacity: 0; }
  }
</style>

<script>
  // Elements
  const triggerBtn = document.getElementById('sim-trigger-btn');
  const btnText = document.getElementById('sim-btn-text');
  const playIcon = document.getElementById('play-icon');

  const agentNode = document.getElementById('agent-node');
  const authNode = document.getElementById('auth-node');
  const sandboxNode = document.getElementById('sandbox-node');

  const arrowReq = document.getElementById('arrow-request');
  const arrowReqMob = document.getElementById('arrow-request-mobile');
  const arrowExec = document.getElementById('arrow-execution');
  const arrowExecMob = document.getElementById('arrow-execution-mobile');

  const logPanel = document.getElementById('sim-log-panel');
  const logStream = document.getElementById('sim-log-stream');
  const logStatus = document.getElementById('sim-log-status');

  let isRunning = false;

  triggerBtn?.addEventListener('click', () => {
    if (isRunning) return;
    runPipelineSimulation();
  });

  function clearLogs() {
    if (logStream) logStream.innerHTML = '';
  }

  function addLog(text: string, colorClass = 'text-gray-400') {
    if (!logStream) return;
    const time = new Date().toLocaleTimeString().split(' ')[0];
    const logLine = document.createElement('div');
    logLine.className = `${colorClass} leading-relaxed`;
    logLine.innerHTML = `<span class="text-gray-600 font-sans mr-2">[${time}]</span> ${text}`;
    logStream.appendChild(logLine);
    logStream.scrollTop = logStream.scrollHeight;
  }

  function runPipelineSimulation() {
    isRunning = true;
    clearLogs();

    // Disable button styling
    if (triggerBtn) {
      triggerBtn.classList.add('opacity-50', 'cursor-not-allowed');
      triggerBtn.classList.remove('hover:bg-accent/15');
    }
    if (btnText) btnText.textContent = "Pipeline Executing...";
    if (playIcon) playIcon.style.display = 'none';

    // Show log panel
    if (logPanel) {
      logPanel.style.opacity = '1';
      logPanel.style.height = 'auto';
      logPanel.style.overflow = 'visible';
    }
    if (logStatus) {
      logStatus.textContent = "EXECUTING";
      logStatus.className = "text-[10px] text-accent animate-pulse font-bold";
    }

    // Step 1: Agent Initiates Request (T=0)
    agentNode?.classList.add('node-active');
    addLog('Autonomous Agent triggered: n8n workspace initiates API action...', 'text-white');
    
    // Step 2: Flow request to Auth Boundary (T=500ms)
    setTimeout(() => {
      arrowReq?.classList.add('arrow-active');
      arrowReqMob?.classList.add('arrow-active');
      arrowReq?.querySelector('.flow-bullet')?.classList.add('flow-bullet-active');
      arrowReqMob?.querySelector('.flow-bullet-vertical')?.classList.add('flow-bullet-vertical-active');
      addLog('Sending request packet to secure gateway with client metadata...', 'text-gray-500');
    }, 600);

    // Step 3: Auth Boundary checks policies (T=1500ms)
    setTimeout(() => {
      authNode?.classList.add('node-active');
      addLog('<span class="text-cyan-400 font-semibold">[AUTH]</span> Querying OpenFGA/Zanzibar relations check...', 'text-cyan-400');
    }, 1500);

    // Step 4: Auth approval and status (T=2500ms)
    setTimeout(() => {
      addLog('      <span class="text-green-500 font-bold">[OK]</span> Relationship matches: "agent_01" is allowed to execute on "env_sandbox".', 'text-gray-300');
      addLog('<span class="text-cyan-400 font-semibold">[AUTH]</span> Issuing short-lived OAuth2 scoped execution token.', 'text-cyan-400');
      authNode?.classList.remove('node-active');
      authNode?.classList.add('node-active-green');
    }, 2800);

    // Step 5: Approved flow to sandbox (T=3800ms)
    setTimeout(() => {
      // Deactivate first flow
      arrowReq?.classList.remove('arrow-active');
      arrowReqMob?.classList.remove('arrow-active');
      arrowReq?.querySelector('.flow-bullet')?.classList.remove('flow-bullet-active');
      arrowReqMob?.querySelector('.flow-bullet-vertical')?.classList.remove('flow-bullet-vertical-active');

      // Activate second flow
      arrowExec?.classList.add('arrow-active');
      arrowExecMob?.classList.add('arrow-active');
      arrowExec?.querySelector('.flow-bullet')?.classList.add('flow-bullet-active');
      arrowExecMob?.querySelector('.flow-bullet-vertical')?.classList.add('flow-bullet-vertical-active');

      addLog('Pushing authenticated execution manifest to sandbox controller...', 'text-gray-500');
    }, 3800);

    // Step 6: Sandbox activates (T=4800ms)
    setTimeout(() => {
      sandboxNode?.classList.add('node-active-green');
      addLog('<span class="text-green-400 font-semibold">[SANDBOX]</span> Hardened Kubernetes Pod controller active.', 'text-green-400');
      addLog('<span class="text-green-400 font-semibold">[SANDBOX]</span> Booting isolated Firecracker microVM container (12ms)... [OK]', 'text-green-400');
    }, 4800);

    // Step 7: Safe execution logs (T=5800ms)
    setTimeout(() => {
      addLog('      <span class="text-yellow-400 font-medium italic">[LOGS]</span> Executing: `npm run build && terraform apply` ...', 'text-gray-500 italic');
      addLog('      <span class="text-yellow-400 font-medium italic">[LOGS]</span> [SecCheck] Restricting egress to mock APIs. Blocked external IPs.', 'text-gray-500 italic');
    }, 6000);

    // Step 8: Execution complete and sandbox teardown (T=7200ms)
    setTimeout(() => {
      addLog('<span class="text-green-400 font-semibold">[SANDBOX]</span> Execution complete. Tearing down microVM instance.', 'text-green-400');
      addLog('<span class="text-green-500 font-bold">&gt;&gt; PIPELINE COMPLETE: Executed isolated, tokens audited.</span>', 'text-green-400 font-bold');
      
      if (logStatus) {
        logStatus.textContent = "SUCCESS";
        logStatus.className = "text-[10px] text-green-500 font-bold";
      }

      // Deactivate second flow
      arrowExec?.classList.remove('arrow-active');
      arrowExecMob?.classList.remove('arrow-active');
      arrowExec?.querySelector('.flow-bullet')?.classList.remove('flow-bullet-active');
      arrowExecMob?.querySelector('.flow-bullet-vertical')?.classList.remove('flow-bullet-vertical-active');
    }, 7200);

    // Step 9: Reset (T=8500ms)
    setTimeout(() => {
      // Clear glows
      agentNode?.classList.remove('node-active');
      authNode?.classList.remove('node-active-green');
      sandboxNode?.classList.remove('node-active-green');

      // Reset button
      if (triggerBtn) {
        triggerBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        triggerBtn.classList.add('hover:bg-accent/15');
      }
      if (btnText) btnText.textContent = "Run Pipeline Simulation";
      if (playIcon) playIcon.style.display = 'block';

      isRunning = false;
    }, 8500);
  }
</script>
