---
interface Props {title:string;date:Date;url:string;tags?:string[];readingTime?:string;featured?:boolean}
const {title,date,url,tags=[],readingTime}=Astro.props;
const formatted=new Intl.DateTimeFormat('en-US',{month:'short',day:'2-digit',year:'numeric',timeZone:'UTC'}).format(date);
---
<a class="writing-row" href={url}><time datetime={date.toISOString()}>{formatted}</time><div><h3>{title}</h3><p class="meta">{tags.slice(0,3).join(' / ')}{readingTime ? ` · ${readingTime}` : ''}</p></div><span class="arrow" aria-hidden="true">↗</span></a>
