---
interface Props {
  title: string;
  date: Date;
  tags: string[];
  url: string;
  featured?: boolean;
}

const { title, date, tags, url, featured = false } = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC'
}).format(date);
---

<a href={url} class={`craft-card block group ${featured ? 'md:col-span-2 border-[var(--border-hover)] bg-[var(--accent-soft)]' : ''}`}>
  <div class="flex items-center justify-between gap-3 mb-2.5 text-xs font-mono text-[var(--text-muted)]">
    <time datetime={date.toISOString()} class="text-[var(--accent)] font-medium">{formattedDate}</time>
    {featured && (
      <span class="px-2 py-0.5 rounded-full bg-[var(--accent)] text-black text-[10px] font-bold uppercase tracking-wider">
        ★ Featured Note
      </span>
    )}
  </div>

  <h3 class={`font-heading font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors mb-3 leading-snug ${featured ? 'text-2xl md:text-3xl' : 'text-lg'}`}>
    {title}
  </h3>

  <div class="flex flex-wrap items-center justify-between gap-2 mt-4 pt-3 border-t border-[var(--border-subtle)]">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-[var(--tag-bg)] border border-[var(--border-subtle)] text-[var(--text-muted)]">
          {tag}
        </span>
      ))}
    </div>
    <span class="text-xs font-mono text-[var(--accent)] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">
      Read note &rarr;
    </span>
  </div>
</a>
