---
interface Props {
  kicker: string;
  title: string;
  description: string;
  stack: string[];
  insightQuote: string;
  link?: string;
}

const { kicker, title, description, stack, insightQuote, link = '/work/' } = Astro.props;
---

<div class="craft-card flex flex-col justify-between group">
  <!-- Top glow accent line -->
  <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-[var(--border-hover)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <div>
    <!-- Category Kicker -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] font-semibold flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></span>
        {kicker}
      </span>
      <a href={link} class="text-[11px] font-mono text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors">
        Read Dossier ↗
      </a>
    </div>

    <h3 class="font-heading font-bold text-xl text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors duration-200 mb-2">
      {title}
    </h3>

    <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-5">
      {description}
    </p>

    <!-- Tech Stack Tags -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {stack.map((tech) => (
        <span class="px-2.5 py-0.5 rounded-full bg-[var(--tag-bg)] border border-[var(--border-subtle)] text-[11px] font-mono text-[var(--text-muted)] group-hover:text-[var(--text-secondary)] transition-colors">
          {tech}
        </span>
      ))}
    </div>
  </div>

  <!-- Insight Callout -->
  <div class="pt-4 border-t border-[var(--border-subtle)] text-xs font-mono text-[var(--text-muted)] italic leading-relaxed flex items-start gap-1.5">
    <span class="text-[var(--accent)] font-bold text-sm leading-none">“</span>
    <span>{insightQuote}”</span>
  </div>
</div>
