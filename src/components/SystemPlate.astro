---
interface Props {kind:'platform'|'identity'|'reliability'}
const {kind}=Astro.props;
---
<div class="system-plate">
{kind==='platform'&&<svg viewBox="0 0 760 220" role="img" aria-label="Platform architecture: teams commit to Git; Argo CD promotes workloads to tenant boundaries in EKS and GKE."><defs><marker id="platform-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="currentColor"/></marker></defs><g fill="none" stroke="currentColor" stroke-width="1.2"><rect x="26" y="75" width="104" height="57"/><rect x="194" y="75" width="111" height="57"/><rect x="370" y="75" width="120" height="57"/><path d="M130 104H190M305 104H365" marker-end="url(#platform-arrow)"/><path d="M490 104H525V56H568M525 104V156H568"/><rect x="570" y="24" width="155" height="64" stroke-dasharray="5 4"/><rect x="570" y="124" width="155" height="64" stroke-dasharray="5 4"/><path d="M644 88V124" stroke-dasharray="2 5"/></g><g fill="currentColor" text-anchor="middle" font-family="monospace" font-size="14"><text x="78" y="108">TEAMS</text><text x="249" y="108">GIT</text><text x="430" y="108">ARGO CD</text><text x="647" y="59">EKS / TENANT</text><text x="647" y="159">GKE / TENANT</text></g><g fill="currentColor" font-family="monospace" font-size="11" opacity=".65"><text x="200" y="157">desired state</text><text x="372" y="157">promotion rules</text><text x="568" y="210">same contract, different cloud</text></g></svg>}
{kind==='identity'&&<svg viewBox="0 0 760 220" role="img" aria-label="Identity architecture: authentication through Kratos, OAuth2 tokens through Hydra, and relationship-based authorization through Keto form separate boundaries for applications."><g fill="none" stroke="currentColor" stroke-width="1.2"><rect x="25" y="74" width="112" height="64"/><rect x="213" y="24" width="143" height="64"/><rect x="213" y="132" width="143" height="64"/><rect x="435" y="74" width="120" height="64"/><rect x="624" y="74" width="110" height="64"/><path d="M137 105H173V56H213M173 105V164H213M356 56H394V106H435M356 164H394V106M555 106H624"/><path d="M588 33V188" stroke-dasharray="4 4"/></g><g fill="currentColor" text-anchor="middle" font-family="monospace" font-size="14"><text x="81" y="111">USER / APP</text><text x="285" y="61">KRATOS</text><text x="285" y="169">HYDRA</text><text x="495" y="111">KETO</text><text x="679" y="111">RESOURCE</text></g><g fill="currentColor" font-family="monospace" font-size="11" opacity=".65"><text x="222" y="106">authentication</text><text x="232" y="215">OAuth2 tokens</text><text x="438" y="162">authorization</text><text x="561" y="21">boundary</text></g></svg>}
{kind==='reliability'&&<svg viewBox="0 0 760 220" role="img" aria-label="Reliability feedback loop: a change goes through policy checks and delivery; operational signals feed lessons back into the next change."><g fill="none" stroke="currentColor" stroke-width="1.2"><rect x="30" y="44" width="132" height="58"/><rect x="227" y="44" width="132" height="58"/><rect x="424" y="44" width="132" height="58"/><rect x="619" y="44" width="112" height="58"/><path d="M162 73H227M359 73H424M556 73H619M675 102V173H96V102"/><path d="M90 111L96 102L102 111"/></g><g fill="currentColor" text-anchor="middle" font-family="monospace" font-size="14"><text x="96" y="79">CHANGE</text><text x="293" y="79">POLICY / CI</text><text x="490" y="79">DELIVER</text><text x="675" y="79">OBSERVE</text></g><rect x="248" y="158" width="272" height="29" fill="var(--plate-bg)"/><text x="384" y="178" text-anchor="middle" fill="currentColor" font-family="monospace" font-size="12">SLOs → incidents → learning</text></svg>}
</div>
