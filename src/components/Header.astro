---
const path=Astro.url.pathname;
const links=[{n:'00',name:'The map',url:'/'},{n:'01',name:'Work',url:'/work/'},{n:'02',name:'Writing',url:'/blog/'},{n:'03',name:'About',url:'/about/'},{n:'04',name:'Now',url:'/now/'}];
---
<header class="masthead">
<a class="wordmark" href="/" aria-label="Viswaroop Vadlamudi — home"><span class="monogram" aria-hidden="true">V/V</span><span>Viswaroop <br/>Vadlamudi<span class="brand-caption">Engineer. Reader.<br/>Work in progress.</span></span></a>
<nav class="nav" aria-label="Main navigation">{links.map(link=><a href={link.url} aria-current={(link.url==='/'?path==='/':path.startsWith(link.url))?'page':undefined}><span class="nav-number">{link.n}</span>{link.name}<span class="nav-indicator" aria-hidden="true">↗</span></a>)}</nav>
<div class="rail-bottom"><span class="rail-note">A personal atlas.<br/>Always being revised.</span><a href="mailto:hello@viswaroop.dev">Say hello ↗</a><a href="https://www.linkedin.com/in/viswaroopvadlamudi/">LinkedIn ↗</a><a href="https://github.com/vviswaroop">GitHub ↗</a></div>
</header>
