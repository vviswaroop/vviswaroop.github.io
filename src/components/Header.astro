---
const currentPath = Astro.url.pathname;
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work/' },
  { label: 'Writing', href: '/blog/' },
  { label: 'About', href: '/about/' },
  { label: 'Now', href: '/now/' },
];
---

<header class="sticky top-4 z-50 max-w-4xl mx-auto w-[calc(100%-2rem)] rounded-full border border-[var(--border-subtle)] bg-[var(--bg-surface)] backdrop-blur-2xl px-5 py-2.5 shadow-[0_12px_32px_-8px_rgba(0,0,0,0.5)] transition-all duration-300">
  <div class="flex items-center justify-between gap-4">
    
    <!-- Monogram Brand & Live Status -->
    <a href="/" class="flex items-center gap-2.5 text-sm font-heading font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors group">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[var(--accent)]"></span>
      </span>
      <span class="tracking-tight font-mono text-xs">viswaroop.dev</span>
    </a>

    <!-- Navigation Pills -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs font-medium">
      {navItems.map(({ label, href }) => {
        const isActive = currentPath === href || (href !== '/' && currentPath.startsWith(href));
        return (
          <a
            href={href}
            class={`px-3 py-1.5 rounded-full transition-all duration-200 ${
              isActive
                ? 'bg-[var(--accent)] text-black font-semibold shadow-[0_0_15px_var(--accent-glow)]'
                : 'text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--tag-bg)]'
            }`}
          >
            {label}
          </a>
        );
      })}
    </nav>

    <!-- Controls: ⌘K Search Trigger + Light/Dark Toggle -->
    <div class="flex items-center gap-2">
      <!-- ⌘K Trigger Button -->
      <button
        id="cmd-k-trigger"
        type="button"
        class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--tag-bg)] border border-[var(--border-subtle)] hover:border-[var(--border-hover)] text-xs font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all cursor-pointer"
        title="Search or jump to page (⌘K)"
        aria-label="Open Command Palette"
      >
        <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="text-[10px] opacity-60">⌘K</kbd>
      </button>

      <!-- Modern Web Guidance: Dark mode toggle -->
      <button
        id="theme-toggle"
        type="button"
        class="w-8 h-8 rounded-full flex items-center justify-center bg-[var(--tag-bg)] border border-[var(--border-subtle)] hover:border-[var(--border-hover)] text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all cursor-pointer"
        title="Toggle Light / Dark mode"
        aria-label="Toggle theme color scheme"
      >
        <svg id="theme-icon-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg id="theme-icon-moon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-nav-toggle"
        type="button"
        class="md:hidden w-8 h-8 rounded-full flex items-center justify-center bg-[var(--tag-bg)] border border-[var(--border-subtle)] text-[var(--text-secondary)]"
        aria-label="Open mobile navigation"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <nav id="mobile-menu" class="hidden md:hidden pt-3 mt-3 border-t border-[var(--border-subtle)] flex flex-col gap-1 font-mono text-xs">
    {navItems.map(({ label, href }) => (
      <a
        href={href}
        class="px-3 py-2 rounded-lg text-[var(--text-secondary)] hover:text-[var(--accent)] hover:bg-[var(--tag-bg)]"
      >
        {label}
      </a>
    ))}
  </nav>
</header>

<script>
  function setupHeader() {
    // ⌘K dispatch
    document.getElementById('cmd-k-trigger')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-cmd-k'));
    });

    // Mobile nav toggle
    const mobileBtn = document.getElementById('mobile-nav-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    mobileBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Theme toggle following modern-web-guidance
    const themeBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun');
    const moonIcon = document.getElementById('theme-icon-moon');
    const metaTheme = document.querySelector('meta[name="color-scheme"]');

    function updateThemeIcons() {
      const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = metaTheme?.content || 'light dark';
      const resolvedDark = current === 'dark' || (current === 'light dark' && isDark);

      if (resolvedDark) {
        sunIcon?.classList.remove('hidden');
        moonIcon?.classList.add('hidden');
      } else {
        sunIcon?.classList.add('hidden');
        moonIcon?.classList.remove('hidden');
      }
    }

    themeBtn?.addEventListener('click', () => {
      if (!metaTheme) return;
      const isSystemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const current = metaTheme.content;
      const currentlyDark = current === 'dark' || (current === 'light dark' && isSystemDark);
      const target = currentlyDark ? 'light' : 'dark';

      // If user toggles to match system, clear stored value to stay responsive to OS changes
      if (target === (isSystemDark ? 'dark' : 'light')) {
        localStorage.removeItem('color-scheme');
        metaTheme.content = 'light dark';
      } else {
        localStorage.setItem('color-scheme', target);
        metaTheme.content = target;
      }

      updateThemeIcons();
    });

    updateThemeIcons();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
