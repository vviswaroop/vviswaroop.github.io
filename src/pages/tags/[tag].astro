---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const tags = [...new Set(posts.flatMap(p => p.data.tags.map(t => t.toLowerCase())))];
  return tags.map(tag => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter(p => p.data.tags.some(t => t.toLowerCase() === tag)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    }
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`Notes on #${tag}`} description={`Field notes tagged with #${tag} from Viswaroop's engineering notebook.`}>
  <div class="py-6 md:py-12 max-w-4xl mx-auto">
    <a href="/blog/" class="inline-flex items-center gap-1.5 text-xs font-mono text-[var(--accent)] hover:underline mb-6">
      ← Back to all field notes
    </a>

    <header class="mb-10 pb-6 border-b border-[var(--border-subtle)]">
      <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">Topic Index</span>
      <h1 class="text-3xl sm:text-5xl font-bold font-heading text-[var(--text-primary)] mt-1 mb-2">
        Notes on <span class="text-[var(--accent)]">#{tag}</span>
      </h1>
      <p class="text-sm font-mono text-[var(--text-muted)]">
        {posts.length} {posts.length === 1 ? 'entry' : 'entries'} found in the notebook.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {posts.map(post => (
        <PostCard
          title={post.data.title}
          date={post.data.date}
          tags={post.data.tags}
          url={`/blog/${post.slug}/`}
        />
      ))}
    </div>
  </div>
</Layout>
