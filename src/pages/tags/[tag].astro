---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
export async function getStaticPaths(){
 const posts=await getCollection('blog');
 const tags=[...new Set(posts.flatMap(p=>p.data.tags.map(t=>t.toLowerCase())))];
 return tags.map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.some(t=>t.toLowerCase()===tag)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf())}}));
}
const {tag,posts}=Astro.props;
---
<Layout title={`Notes on ${tag}`} description={`Writing about ${tag} from Viswaroop’s notebook.`}>
<header class="page-heading"><p class="eyebrow blue">The notebook / Topic index</p><h1>Notes on <em>{tag}.</em></h1><p>{posts.length} {posts.length===1?'entry':'entries'} in the notebook.</p></header>
<div class="page-body"><a class="text-link" style="margin-bottom:30px" href="/blog/">← All writing</a>{posts.map(post=><PostCard title={post.data.title} date={post.data.date} tags={post.data.tags} url={`/blog/${post.slug}/`} readingTime={`${Math.ceil(post.body.trim().split(/\s+/).length/200)} min read`}/>)}</div>
</Layout>
