---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const allTags = [...new Set(allPosts.flatMap(post => post.data.tags))].sort();
const featuredPost = sortedPosts[0];
const recentPosts = sortedPosts.slice(1);
---

<Layout title="Writing" description="Field notes on platform engineering, identity boundaries, and agentic AI.">
  <div class="py-6 md:py-12">
    <!-- Header -->
    <div class="mb-8">
      <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">Engineering Notebook</span>
      <h1 class="text-3xl md:text-5xl font-bold font-heading text-[var(--text-primary)] mt-1 mb-3">Writing & Field Notes</h1>
      <p class="text-sm md:text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
        Deep dives into infrastructure reality, identity boundaries, and the architectural shifts required when software acts as an autonomous user.
      </p>
    </div>

    <!-- Live Search & Tags Navigation -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-[var(--border-subtle)]">
      <!-- Tag Chips -->
      <div class="flex flex-wrap items-center gap-1.5" id="tag-filter-list">
        <button
          type="button"
          data-tag="all"
          class="tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[var(--accent)] text-black cursor-pointer transition-all"
        >
          All ({sortedPosts.length})
        </button>
        {allTags.map(tag => (
          <button
            type="button"
            data-tag={tag.toLowerCase()}
            class="tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium bg-[var(--tag-bg)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer transition-all"
          >
            {tag}
          </button>
        ))}
      </div>

      <!-- Real-Time Search Bar -->
      <div class="relative w-full sm:w-64">
        <input
          id="post-search-input"
          type="search"
          placeholder="Filter notes..."
          class="w-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-full px-4 py-1.5 text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--accent)] transition-all font-mono pl-9"
          aria-label="Filter blog posts"
        />
        <svg class="w-3.5 h-3.5 text-[var(--accent)] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>

    <!-- Posts Grid -->
    <div id="posts-container" class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {featuredPost && (
        <div class="post-item md:col-span-2" data-tags={featuredPost.data.tags.join(' ').toLowerCase()} data-title={featuredPost.data.title.toLowerCase()}>
          <PostCard
            title={featuredPost.data.title}
            date={featuredPost.data.date}
            tags={featuredPost.data.tags}
            url={`/blog/${featuredPost.slug}/`}
            featured={true}
          />
        </div>
      )}

      {recentPosts.map(post => (
        <div class="post-item" data-tags={post.data.tags.join(' ').toLowerCase()} data-title={post.data.title.toLowerCase()}>
          <PostCard
            title={post.data.title}
            date={post.data.date}
            tags={post.data.tags}
            url={`/blog/${post.slug}/`}
            featured={false}
          />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="no-results" class="hidden py-16 text-center text-sm font-mono text-[var(--text-muted)]">
      No matching field notes found. Try another query or select "All".
    </div>
  </div>
</Layout>

<script>
  function setupBlogSearch() {
    const searchInput = document.getElementById('post-search-input') as HTMLInputElement | null;
    const postItems = document.querySelectorAll<HTMLElement>('.post-item');
    const tagButtons = document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn');
    const noResults = document.getElementById('no-results');

    let currentTag = 'all';
    let currentQuery = '';

    function filterPosts() {
      let visibleCount = 0;

      postItems.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const tags = item.getAttribute('data-tags') || '';

        const matchesTag = currentTag === 'all' || tags.includes(currentTag);
        const matchesQuery = currentQuery === '' || title.includes(currentQuery) || tags.includes(currentQuery);

        if (matchesTag && matchesQuery) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterPosts();
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        tagButtons.forEach(b => {
          b.className = 'tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-medium bg-[var(--tag-bg)] border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:border-[var(--border-hover)] hover:text-[var(--text-primary)] cursor-pointer transition-all';
        });

        btn.className = 'tag-filter-btn px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[var(--accent)] text-black cursor-pointer transition-all';

        currentTag = btn.getAttribute('data-tag') || 'all';
        filterPosts();
      });
    });
  }

  setupBlogSearch();
  document.addEventListener('astro:page-load', setupBlogSearch);
</script>
