---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const tags=[...new Set(posts.flatMap(p=>p.data.tags.map(t=>t.toLowerCase())))].sort();
---
<Layout title="Writing" description="Field notes on platforms, identity, books, and the things I’m learning. Essays by Viswaroop Vadlamudi.">
  <header class="page-heading"><p class="eyebrow blue">The notebook / Writing</p><h1>Thinking, written down.</h1><p>Notes from building systems and living with their tradeoffs. And occasionally, a book that changed how I think.</p></header>
  <div class="page-body"><nav class="tags" aria-label="Filter writing by topic"><a class="tag active" href="/blog/" aria-current="page">All notes</a>{tags.map(tag=><a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}</nav>
  <div>{posts.map(post=><PostCard title={post.data.title} date={post.data.date} tags={post.data.tags} url={`/blog/${post.slug}/`} readingTime={`${Math.ceil(post.body.trim().split(/\s+/).length/200)} min read`}/>)}</div><Newsletter/></div>
</Layout>
