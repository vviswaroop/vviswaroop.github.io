---
import {getCollection} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Newsletter from '../../components/Newsletter.astro';
export async function getStaticPaths(){return (await getCollection('blog')).map(post=>({params:{slug:post.slug},props:{post}}))}
const {post}=Astro.props;
const {Content,headings}=await post.render();
const toc=headings.filter(h=>h.depth>1&&h.depth<=3);
const readingTime=Math.ceil(post.body.trim().split(/\s+/).length/200);
const formattedDate=new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(post.data.date);
---
<Layout title={post.data.title} description={post.data.description||`${post.data.title} — notes by ${post.data.author}.`} article={true} publishDate={post.data.date} author={post.data.author}>
<header class="page-heading"><a href="/blog/" class="eyebrow blue">← Back to the notebook</a><h1 style="max-width:960px;font-size:clamp(38px,5vw,62px)">{post.data.title}</h1><div class="article-meta"><time datetime={post.data.date.toISOString()}>{formattedDate}</time><span>{readingTime} min read</span><span>{post.data.author}</span></div></header>
<div class="page-body"><div class="tags">{post.data.tags.map((tag:string)=><a class="tag" href={`/tags/${tag.toLowerCase()}/`}>{tag}</a>)}</div>
<div class="article-layout"><article><div class="prose"><Content/></div><Newsletter/><footer class="article-footer"><a href="/blog/">← All writing</a><a href={`https://github.com/vviswaroop/vviswaroop.github.io/blob/main/src/content/blog/${post.id}`}>Suggest an edit on GitHub ↗</a></footer></article>
{toc.length>0&&<aside class="article-toc"><details open><summary class="eyebrow muted">In this note</summary><nav aria-label="On this page"><ul>{toc.map(h=><li class={h.depth===3?'nested':''}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></details></aside>}
</div></div>
</Layout>
