---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="About" 
  description="Staff Software Engineer bridging traditional cloud infrastructure and the frontier of Agentic AI."
>
  <div class="max-w-3xl mx-auto py-6 md:py-12">
    <!-- Header -->
    <div class="mb-10 pb-6 border-b border-[var(--border-subtle)]">
      <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">Background & Focus</span>
      <h1 class="text-3xl sm:text-5xl font-bold font-heading text-[var(--text-primary)] mt-1 mb-3">About Viswaroop</h1>
      <p class="text-base text-[var(--text-secondary)] leading-relaxed">
        Staff Software Engineer focused on platform infrastructure, identity systems, and the blast-radius boundaries of autonomous AI.
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="space-y-10 text-[var(--text-secondary)] leading-relaxed font-sans">
      
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-[var(--text-primary)] font-heading">
          Where I Focus
        </h2>
        <p>
          I'm a Staff Software Engineer bridging the gap between traditional robust infrastructure and the frontier of Agentic AI. I build foundational platforms that let autonomous agents and engineering teams ship fast without breaking security, compliance, or each other.
        </p>
        <p>
          I've spent over a decade running multi-tenant Kubernetes platforms across AWS and GCP, replacing managed identity services with open-source IAM, and making GitOps work beyond dozens of product teams.
        </p>
        <p>
          As software shifts toward autonomous execution—tools that act <em>as</em> the user asynchronously—my focus is ensuring those workflows run within strict, zero-trust execution sandboxes with relationship-based authorization (Zanzibar / OAuth2) and blast-radius containment.
        </p>
      </section>

      <!-- Contact & Channels Grid -->
      <section class="pt-6 border-t border-[var(--border-subtle)]">
        <h2 class="text-xl font-bold text-[var(--text-primary)] font-heading mb-4">
          Connect & Inquiries
        </h2>
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="mailto:hello@viswaroop.dev" class="craft-card p-4 block group">
            <span class="text-[11px] font-mono uppercase text-[var(--accent)] block mb-1">Direct Email</span>
            <span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] block transition-colors">hello@viswaroop.dev</span>
            <span class="text-xs text-[var(--text-muted)] mt-1 block">General & advisory</span>
          </a>

          <a href="https://github.com/vviswaroop" target="_blank" rel="noopener noreferrer" class="craft-card p-4 block group">
            <span class="text-[11px] font-mono uppercase text-[var(--accent)] block mb-1">Open Source</span>
            <span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] block transition-colors">github.com/vviswaroop</span>
            <span class="text-xs text-[var(--text-muted)] mt-1 block">Code & experiments</span>
          </a>

          <a href="https://linkedin.com/in/viswaroopvadlamudi" target="_blank" rel="noopener noreferrer" class="craft-card p-4 block group">
            <span class="text-[11px] font-mono uppercase text-[var(--accent)] block mb-1">Network</span>
            <span class="text-sm font-semibold text-[var(--text-primary)] group-hover:text-[var(--accent)] block transition-colors">LinkedIn Profile</span>
            <span class="text-xs text-[var(--text-muted)] mt-1 block">Professional background</span>
          </a>
        </div>
      </section>

      <!-- Speaking / Advisory -->
      <section class="craft-card bg-[var(--accent-soft)] border-[var(--border-hover)] p-6 rounded-2xl">
        <h3 class="text-lg font-bold text-[var(--text-primary)] font-heading mb-2">
          Advisory, Speaking & Podcasts
        </h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
          I'm available for staff-level architectural reviews, conference talks, and podcasts on Agentic AI execution boundaries, Zanzibar authorization at scale, and Kubernetes multi-tenancy.
        </p>
        <a href="mailto:hello@viswaroop.dev?subject=Speaking%20or%20Advisory%20Inquiry" class="btn-primary">
          Send Speaking Inquiry ↗
        </a>
      </section>

    </div>
  </div>
</Layout>
