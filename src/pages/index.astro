---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AgentSandboxDemo from '../components/AgentSandboxDemo.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const latestPost = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];
---

<Layout title="Home">
  <!-- Hero Section -->
  <section class="min-h-[55vh] flex flex-col justify-center relative py-10 md:py-16">
    <div class="space-y-6 max-w-3xl">
      
      <!-- Live Availability / Telemetry Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[var(--border-subtle)] bg-[var(--tag-bg)] text-xs text-[var(--accent)] font-mono shadow-[0_0_20px_var(--accent-glow)]">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--accent)] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--accent)]"></span>
        </span>
        <span>Operational: Exploring zero-trust boundaries for Agentic AI</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[var(--text-primary)] leading-[1.1]">
        I build infrastructure for <span class="text-[var(--accent)]">AI agents</span>. <br class="hidden sm:inline" />
        Then I write about why it breaks.
      </h1>

      <p class="text-base sm:text-lg md:text-xl text-[var(--text-secondary)] font-normal leading-relaxed max-w-2xl">
        Staff Software Engineer specializing in identity systems, relationship-based authorization (Zanzibar / OAuth2), and multi-tenant Kubernetes platforms built for resilience at scale.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap gap-3 pt-2">
        <a href="#featured-systems" class="btn-primary">
          Explore Systems ↘
        </a>
        <a href="/blog/" class="btn-secondary">
          Read Field Notes →
        </a>
      </div>

      <!-- Quick Telemetry Strip -->
      <div class="pt-6 border-t border-[var(--border-subtle)] grid grid-cols-2 sm:grid-cols-4 gap-4 font-mono text-xs">
        <div>
          <span class="block text-lg font-bold text-[var(--text-primary)] font-heading">10+ Yrs</span>
          <span class="text-[var(--text-muted)]">Platform Engineering</span>
        </div>
        <div>
          <span class="block text-lg font-bold text-[var(--text-primary)] font-heading">Multi-Cloud</span>
          <span class="text-[var(--text-muted)]">AWS EKS & GCP GKE</span>
        </div>
        <div>
          <span class="block text-lg font-bold text-[var(--text-primary)] font-heading">Zero-Trust</span>
          <span class="text-[var(--text-muted)]">Agent Sandboxes</span>
        </div>
        <div>
          <span class="block text-lg font-bold text-[var(--text-primary)] font-heading">US Central</span>
          <span class="text-[var(--text-muted)]">Advisory & Staff</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Sandbox Artifact Section -->
  <section class="py-10 border-t border-[var(--border-subtle)] relative">
    <div class="mb-6">
      <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">01 / Signature Artifact</span>
      <h2 class="text-2xl font-bold text-[var(--text-primary)] font-heading mt-1">Playable Execution Flow</h2>
      <p class="text-sm text-[var(--text-secondary)] mt-1">Interact with the real-time simulation below to see how M2M tokens, policy gates, and sandboxes behave.</p>
    </div>
    
    <AgentSandboxDemo />
  </section>

  <!-- Core Architecture Pillars -->
  <section class="py-14 border-t border-[var(--border-subtle)]">
    <div class="mb-8">
      <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">02 / Technical Domains</span>
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] font-heading mt-1">Foundational Pillars</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="craft-card">
        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2 font-heading">AI Infrastructure & Orchestration</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Securing LLM pipelines, managing GPU workloads on K8s, and establishing zero-trust execution sandboxes for autonomous workflow agents (Open Claw, n8n, worker swarms).
        </p>
      </div>

      <div class="craft-card">
        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2 font-heading">Identity & Relationship Authorization</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Open-source IAM (ORY Hydra / Kratos / Keto), Zanzibar-style relationship permissions (ReBAC), OAuth2 token boundaries, and multi-tenant borders that survive enterprise audits.
        </p>
      </div>

      <div class="craft-card">
        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2 font-heading">Multi-Cloud Platform Engineering</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Normalized application delivery across AWS EKS and GCP GKE using Argo CD, Kustomize, and Helm. Tenant-aware namespaces, policy-as-code, and blast radius containment.
        </p>
      </div>

      <div class="craft-card">
        <h3 class="text-lg font-bold text-[var(--text-primary)] mb-2 font-heading">Reliability, Observability & SLOs</h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
          Paved-road patterns, OpenSearch / Elastic, meaningful SLO definitions, actionable alerting, and closing the loop between production incidents and architectural decisions.
        </p>
      </div>
    </div>
  </section>

  <!-- Featured Systems Section -->
  <section id="featured-systems" class="py-14 border-t border-[var(--border-subtle)]">
    <div class="flex items-end justify-between mb-8">
      <div>
        <span class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider font-semibold">03 / Case Studies</span>
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] font-heading mt-1">Featured Systems</h2>
      </div>
      <a href="/work/" class="text-xs font-mono text-[var(--accent)] hover:underline hidden sm:block">
        View all architectural dossiers ↗
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <ProjectCard 
        kicker="SYS—001 · Multi-Cloud"
        title="GitOps-first multi-cloud platform"
        description="Normalized app delivery across AWS and GCP with tenant-aware namespaces, promotion pipelines, and SLOs baked into templates."
        stack={['ArgoCD', 'Kustomize', 'Helm', 'EKS', 'GKE']}
        insightQuote="Blast radius alignment is a delivery problem, not just a security one."
        link="/work/#multi-cloud"
      />

      <ProjectCard 
        kicker="SYS—002 · Identity"
        title="Open-source IAM replacing AWS Cognito"
        description="Replaced managed identity with ORY stack — auth boundaries that survive org growth, audits, and complex enterprise SSO."
        stack={['ORY Hydra', 'Kratos', 'Keto', 'OAuth2']}
        insightQuote="Cost and lock-in tradeoffs must be made explicit before you're three years in."
        link="/work/#identity"
      />

      <ProjectCard 
        kicker="SYS—003 · Reliability"
        title="Platform reliability guardrails"
        description="Paved-road patterns and pre-flight checks so platform changes ship fast without breaking security or compliance."
        stack={['SLOs', 'OPA', 'Runbooks', 'GitOps']}
        insightQuote="Guardrails beat gates. Teams self-serve when the path is obvious."
        link="/work/#reliability"
      />
    </div>
  </section>

  <!-- Latest Note Callout -->
  {latestPost && (
    <section class="py-10 border-t border-[var(--border-subtle)]">
      <div class="craft-card bg-[var(--accent-soft)] border-[var(--border-hover)]">
        <div class="flex items-center justify-between gap-2 mb-3 text-xs font-mono text-[var(--accent)] font-semibold">
          <span>LATEST NOTE FROM THE NOTEBOOK</span>
          <span>{latestPost.data.tags.join(' · ')}</span>
        </div>
        <h3 class="text-xl md:text-2xl font-bold text-[var(--text-primary)] font-heading mb-2">
          {latestPost.data.title}
        </h3>
        <p class="text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
          When autonomous AI agents act on your behalf while you sleep, traditional user-centric identity boundaries break. OAuth2 and short-lived tokens expect humans; autonomous agents require strict Sandboxing and Zanzibar-style relationship permissions.
        </p>
        <a href={`/blog/${latestPost.slug}/`} class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-[var(--accent)] hover:underline">
          Read full analysis ↗
        </a>
      </div>
    </section>
  )}

  <!-- Advisory / Contact Banner -->
  <section class="py-14 border-t border-[var(--border-subtle)] text-center">
    <div class="max-w-xl mx-auto space-y-4">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--text-primary)] font-heading">
        Have a complex platform or agent boundary problem?
      </h2>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
        I'm available for staff-level architectural advisory, podcast conversations, and conference speaking on Agentic AI sandboxing, IAM migrations, and Kubernetes multi-tenancy.
      </p>
      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a href="mailto:hello@viswaroop.dev" class="btn-primary">
          Send an email ↗
        </a>
        <a href="https://linkedin.com/in/viswaroopvadlamudi" target="_blank" rel="noopener noreferrer" class="btn-secondary">
          LinkedIn Profile ↗
        </a>
      </div>
    </div>
  </section>
</Layout>
